    { "@id": "ex:registradoPor", "@type": "rdf:Property", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "ex:dataHoraRegistro", "@type": "rdf:Property", "rdfs:range": { "@id": "xsd:dateTime" } },
    { "@id": "ex:correlationId", "@type": "rdf:Property", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "ex:origemOperacao", "@type": "rdf:Property", "rdfs:range": { "@id": "xsd:string" } },

    {
      "@id": "ex:justificativa-adequada",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:TransferenciaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Transferência de ativo entre pessoas ou locais",
      "bsh:reason": "A adequação da justificativa exige julgamento contextual.",
      "rdfs:comment": "Toda transferência requer justificativa adequada ao contexto."
    },
    {
      "@id": "ex:motivo-baixa-adequado",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:BaixaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Baixa de ativo",
      "bsh:reason": "A adequação do motivo da baixa exige julgamento contextual.",
      "rdfs:comment": "Toda baixa exige motivo adequado ao contexto."
    },
    {
      "@id": "ex:baixa-alto-valor",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:BaixaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Baixa de ativo com valor de aquisição superior a R$ 10.000",
      "bsh:reason": "Baixas de bens de alto valor patrimonial exigem alçada de Diretoria ou Controladoria.",
      "rdfs:comment": "Baixa de ativo de alto valor (> R$ 10.000) requer aprovação formal de alçada executiva."
    },
    {
      "@id": "ex:baixa-valor-residual",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:BaixaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Baixa de ativo com valor residual contábil positivo",
      "bsh:reason": "O descarte de bem não totalmente depreciado exige parecer contábil e laudo técnico.",
      "rdfs:comment": "Baixa de ativo com valor residual positivo requer revisão humana e laudo técnico de descarte."
    },
    {
      "@id": "ex:recuperacao-extraviado",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:RecuperacaoAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Recuperação de ativo previamente marcado como extraviado",
      "bsh:reason": "A reintegração de bem extraviado exige validação física de integridade e encerramento de sinistro.",
      "rdfs:comment": "Recuperação de ativo extraviado requer verificação humana de laudo e custódia."
    },
    {
      "@id": "ex:transferencia-inter-unidades",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:TransferenciaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Transferência entre unidades organizacionais ou centros de custo distintos",
      "bsh:reason": "Transferências inter-unidades envolvem realocação orçamentária e exigem concordância das lideranças.",
      "rdfs:comment": "Transferência entre unidades distintas exige revisão de alçada gerencial."
    },
    {
      "@id": "ex:aprovacao-diretoria-controladoria",
      "@type": "bsh:Policy",
      "bsh:governs": { "@id": "ex:BaixaAtivo" },
      "bsh:requiresHumanReview": true,
      "bsh:scope": "Descarte ou alienação patrimonial estratégica",
      "bsh:reason": "Aprovação superior por órgãos de governança corporativa.",
      "rdfs:comment": "Decisões patrimoniais estratégicas requerem alçada da Diretoria e Controladoria."
    }
  ]
}
