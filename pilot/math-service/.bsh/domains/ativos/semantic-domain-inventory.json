    { "id": "ex:TransferenciaCompatibilidadeOrganizacionalShape", "targetClass": "ex:TransferenciaAtivo", "type": "SHACL-SPARQL" },
    { "id": "ex:BaixaValorResidualShape", "targetClass": "ex:BaixaAtivo", "type": "SHACL-SPARQL" }
  ],
  "policies": [
    { "id": "ex:justificativa-adequada", "governs": "ex:TransferenciaAtivo", "requiresHumanReview": true },
    { "id": "ex:motivo-baixa-adequado", "governs": "ex:BaixaAtivo", "requiresHumanReview": true },
    { "id": "ex:baixa-alto-valor", "governs": "ex:BaixaAtivo", "requiresHumanReview": true },
    { "id": "ex:baixa-valor-residual", "governs": "ex:BaixaAtivo", "requiresHumanReview": true },
    { "id": "ex:recuperacao-extraviado", "governs": "ex:RecuperacaoAtivo", "requiresHumanReview": true },
    { "id": "ex:transferencia-inter-unidades", "governs": "ex:TransferenciaAtivo", "requiresHumanReview": true },
    { "id": "ex:aprovacao-diretoria-controladoria", "governs": "ex:BaixaAtivo", "requiresHumanReview": true }
  ],
  "lifecycleRules": [
    { "rule": "Ativo em estado Baixado é terminal e não aceita mutações normais (transferência, troca de responsável, mudança de local, baixa subsequente)." },
    { "rule": "Apenas ativos Disponivel podem ser reservados." },
    { "rule": "Ativo em manutenção ou extraviado não pode ser alocado a usuário final." },
    { "rule": "Ativo em trânsito somente pode sofrer recebimento formal." },
    { "rule": "Ativo extraviado exige laudo formal para ser recuperado e retornar ao estado Disponivel." },
    { "rule": "Equipamento com manutenção periódica vencida não pode ser enviado para operação." },
    { "rule": "Instrumentação com calibração vencida exige recertificação antes do uso." }
  ],
  "shaclSparqlConstraints": [
    {
      "id": "ex:TransferenciaCompatibilidadeOrganizacionalShape",
      "targetClass": "ex:TransferenciaAtivo",
      "logic": "FILTER NOT EXISTS { ?responsavel ex:lotadoEmDepartamento ?deptoDestino }"
    },
    {
      "id": "ex:BaixaValorResidualShape",
      "targetClass": "ex:BaixaAtivo",
      "logic": "FILTER (?valorResidual > 0) FILTER NOT EXISTS { $this ex:laudoTecnicoDescarte ?laudo . FILTER (BOUND(?laudo) && str(?laudo) != '') }"
    }
  ]
}
