{
  "name": "business-semantic-harness",
  "version": "0.2.11-beta",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "bsh": "dist/cli.js",
    "business-semantic-harness": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-bin.mjs",
    "check": "tsc --noEmit",
    "lint": "biome lint src",
    "quality": "npm run check && npm run lint",
    "pretest": "npm run quality",
    "test": "npm run build && node --test test/*.test.mjs test/*/*.test.mjs",
    "test:e2e": "npm run build && node --test --experimental-test-isolation=none test/e2e-live/*.e2e.mjs",
    "test:e2e:semantic": "npm run build && node --test --experimental-test-isolation=none test/e2e-live/*.semantic.mjs",
    "capture": "python3 test/support/tmux-screenshot.py",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentui/core": "0.5.14",
    "bun": "1.4.2",
    "jsonld": "^9.0.0",
    "n3": "^2.7.12",
    "shacl-engine": "^1.1.2",
    "zod": "^4.6.5"
  }
}
